{
  "version": "2.0.0",
  "tasks": 
  [
    {
      "label": "format",
      "type": "shell",
      "command": "alejandra",
      "args": ["${workspaceFolder}", "2&1>/dev/null"],
      "presentation": { "reveal": "never", "showReuseMessage": false }
    },
    {
      "label": "stage",
      "type": "process",
      "command": "git",
      "args": ["add", "${workspaceFolder}"],
      "presentation": { "reveal": "never", "showReuseMessage": false }
    },
    {
      "label": "run",
      "type": "process",
      "command": "nu",
      "args": ["${workspaceFolder}/eval-tests.nu"],
      "dependsOn":["format", "stage"],
      "dependsOrder": "sequence"
    },
  ]
}
